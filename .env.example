# Server-side only. Never use a VITE_ prefix for these secrets.
TYPESAFE_API_KEY=
# Optional: writes the reader's brief on each book page from the measured data.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.8-flash
# Local mode: upload and analyse your own books (on by default outside production).
# LOCAL_MODE=1 enables it in production; LOCAL_MODE=0 disables it in development.
# LOCAL_MODE=
# Corpus text: excerpts only by default; CORPUS_FULL_TEXT=1 sends whole books (private use only).
# CORPUS_FULL_TEXT=
# HOST=127.0.0.1
# PORT=5173

# Production origin behind the Coolify HTTPS proxy.
# APP_ORIGIN=https://pelevindb.xyz
# XBOOK_DB=/app/data/xbook.db

# Public web client ID only; never add an OpenPanel client secret here.
# Runtime configuration: changing these requires a restart, not a rebuild.
OPENPANEL_CLIENT_ID=
# OPENPANEL_API_URL=https://api.openpanel.dev
